&uart0 {
    status = "okay";
    pinctrl-0 = < &uart0a_tx_p2_12 &uart0a_rx_p2_11 >;
    pinctrl-names = "default";
    current-speed = < 115200 >;
    data-bits = < 0x8 >;
};

&uart2 {
    current-speed = < 115200 >;
};

/ {
    chosen {
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
    };
    aliases {
        kcomms = &uart2;
    };
    /* Starting with Zephyr 4.4.x, a secondary RiscV core
    is added to the device tree. This causes renode to
    try running the ARM ELF in a RiscV core. */
    cpus {
        cpu@1 {
            reg = <1>;
            status = "disabled";
        };
    };
};
